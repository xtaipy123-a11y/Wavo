# Local development default: http://localhost:1337
# Production default: https://api.tryliner.fun (or custom instance)
VITE_API_URL=http://localhost:1337
VITE_COVERS_PROXY_URL=https://covers.tryliner.fun

# Supabase Auth (renderer is built with Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Enable only for a Wavo-owned music API that validates Supabase JWTs.
VITE_MUSIC_API_ACCEPTS_SUPABASE_JWT=false

WAVO_DEV_SIGNING_SECRET=
