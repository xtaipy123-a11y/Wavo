{
  "name": "cinecloud",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "CineCloud desktop hub with Movo and Wavo",
  "author": "CineCloud",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "release:win": "tsc -b && vite build && electron-builder --win --publish never",
    "release:movo:win": "tsc -b && vite build --mode movo && electron-builder --config electron-builder-movo.json --win --publish never"
  },
  "build": {
    "appId": "com.cinecloud.desktop",
    "productName": "CineCloud",
    "artifactName": "CineCloud-Setup-${version}.${ext}",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "win": { "icon": "build/icon.ico", "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vite-plugin-electron": "^1.1.1"
  }
}
